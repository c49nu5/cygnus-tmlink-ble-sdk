<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               x:Class="Sample.TMLink.Client.Views.NewRecordView"
               xmlns:viewModels="clr-namespace:Sample.TMLink.Client.ViewModels"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:DataType="viewModels:NewRecordViewModel"
               Margin="0"               
               Padding="0">
    <ContentView.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="Black"/>
        </Style>
        <Style TargetType="Picker">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="TextColor" Value="Black"/>
        </Style>
        <Style TargetType="Entry">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="TextColor" Value="Black"/>
        </Style>
    </ContentView.Resources>
    <Grid
        Margin="20"
        RowDefinitions="Auto,Auto,Auto,Auto">
        <Grid ColumnDefinitions="Auto,*">
            <Label
                Margin="10"
                Text="Record Type"/>
            <Picker
                Grid.Column="1"
                SelectedItem="{Binding SelectedType}"
                ItemsSource="{Binding RecordTypes}"/>
        </Grid>
        <HorizontalStackLayout
            Grid.Row="1">
            <Label
                Margin="10"
                Text="New Record Name"/>
            <Label
                Margin="10"
                Text="{Binding Name}"/>
        </HorizontalStackLayout>
        <Grid ColumnDefinitions="60,*,60,*"
            IsVisible="{Binding SelectedType, Converter={toolkit:IsEqualConverter}, ConverterParameter=Grid2D}"
            Grid.Row="2">
            <Label
                Grid.Column="0"
                Margin="10"
                Text="Rows"/>
            <Entry
                Grid.Column="1"
                Text="{Binding RowCount, Mode=TwoWay}"/>
            <Label
                Grid.Column="2"
                Margin="10"
                Text="Cols"/>
            <Entry
                Grid.Column="3"
                Text="{Binding ColumnCount, Mode=TwoWay}"/>
        </Grid>
        <Grid
            ColumnDefinitions="180,*"
            IsVisible="{Binding SelectedType, Converter={toolkit:IsEqualConverter}, ConverterParameter=Linear}"
            Grid.Row="2">
            <Label
                Margin="10"
                Text="Measurement Count"/>
            <Entry
                Grid.Column="1"
                Text="{Binding ColumnCount, Mode=TwoWay}"/>
        </Grid>
        <HorizontalStackLayout
            Grid.Row="3"
                HorizontalOptions="End">
            <Button
                    Margin="10"
                    Text="OK"
                    Command="{Binding OKCommand}"/>
            <Button
                    Margin="10"
                    Text="Cancel"
                    Command="{Binding CancelCommand}"/>
        </HorizontalStackLayout>
    </Grid>
</toolkit:Popup>
